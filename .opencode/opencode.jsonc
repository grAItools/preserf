// OpenCode configuration. See https://opencode.ai/docs/config/
{
  "$schema": "https://opencode.ai/config.json",

  // AGENTS.md is the canonical instructions file. We also load architecture
  // and style as context so the primary agent has them at hand without
  // bloating AGENTS.md itself.
  "instructions": [
    "AGENTS.md",
    "docs/architecture.md",
    "docs/style.md"
  ],

  // Default mode. `build` is the full-access primary; switch to `plan` for
  // read-only planning sessions.
  "default_agent": "build",

  // Permission policy. The deny-list mirrors the canonical destructive-command
  // matcher at .agents/hooks/block-destructive.sh (OpenCode cannot call a
  // script, so these globs are kept in sync with it by hand). The allow-list
  // matches .claude/settings.json: pixi is the build tool, plus read-only helpers.
  "permission": {
    "bash": {
      "pixi *": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "git push --force*": "deny",
      "git reset --hard origin*": "deny",
      "rm -rf*": "deny"
    }
  }
}
