// OpenCode configuration. See https://opencode.ai/docs/config/
{
  "$schema": "https://opencode.ai/config.json",

  // AGENTS.md is the canonical instructions file. We also load architecture
  // and style as context so the primary agent has them at hand without
  // bloating AGENTS.md itself.
  "instructions": [
    "AGENTS.md",
    "docs/architecture.md",
    "docs/style.md"
  ],

  // Default mode. `build` is the full-access primary; switch to `plan` for
  // read-only planning sessions.
  "default_agent": "build",

  // Permission policy — mirrors .claude/settings.json deny list.
  "permission": {
    "bash": {
      "make *": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "rg *": "allow",
      "git push --force*": "deny",
      "git reset --hard origin*": "deny",
      "rm -rf*": "deny"
    }
  },

  // Auto-format edited files — OpenCode's native `formatter`, which runs after
  // every write/edit (the analogue of Claude Code's PostToolUse format hook).
  // We pin both languages to the repo's pixi tasks so editor-time formatting is
  // byte-for-byte what `pixi run verify` (fmt-check) enforces, and disable the
  // built-in `ruff` to avoid double-formatting Python. "$FILE" is replaced with
  // the path of the edited file; matching is by `extensions`. See
  // docs/harness-usage.md.
  //
  // Note: OpenCode has no config-level session-end hook, so there is no
  // automatic verification gate here — run `/verify` during the session and
  // rely on CI. Destructive-bash blocking is the `permission.bash` deny list
  // above (command-prefix globs; see the doc for the caveat vs Claude Code).
  "formatter": {
    "ruff": { "disabled": true },
    "preserf-python": {
      "command": ["pixi", "run", "fmt-py-src", "--", "$FILE"],
      "extensions": [".py"]
    },
    "preserf-fortran": {
      "command": ["pixi", "run", "fmt-f-src", "--", "$FILE"],
      "extensions": [".f90", ".F90", ".f", ".F"]
    }
  }
}
