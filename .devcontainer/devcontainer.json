{
  "name": "preserf",
  "image": "mcr.microsoft.com/devcontainers/base:debian-12",
  "containerEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.pixi/bin"
  },
  "postCreateCommand": "curl -fsSL https://pixi.sh/install.sh | bash && $HOME/.pixi/bin/pixi install --environment dev",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
