!> Generated by CMake's `configure_file` from `preserf_version.f90.in`.
!>
!> Single source of truth for the preserf-fortran helper's version
!> string. Derived from `project(... VERSION ...)` in
!> src/preserf/fortran/CMakeLists.txt at configure time.
!>
!> NB the module is `preserf_version_mod`, not `preserf_version`,
!> because the latter would clash case-insensitively with the
!> `PRESERF_VERSION` parameter it exports.
module preserf_version_mod
    implicit none
    private
    character(len=*), parameter, public :: PRESERF_VERSION = '@PROJECT_VERSION@'
end module preserf_version_mod
